{
  "name": "amr-mohamed-teacher-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "نظام متكامل لإدارة المجموعات التعليمية مع تتبع المدفوعات والإحصائيات المالية",
  "keywords": [
    "education",
    "teacher",
    "dashboard",
    "arabic",
    "react",
    "vite",
    "supabase",
    "pwa"
  ],
  "author": "TaHa M",
  "license": "MIT",
  "homepage": "https://teacher-dashboard.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/teacher-dashboard.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "vercel-build": "npm run build",
    "start": "npm run preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.5",
    "terser": "^5.24.0",
    "vite": "^4.5.0",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
